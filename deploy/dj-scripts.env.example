# Copia a /opt/dj-scripts/.env y ajusta. Este fichero NO se sube a git.

# --- Biblioteca ---
MUSIC_FOLDER=/srv/dj-music/DJ_SCRIPTS_LIB
DB_PATH=/srv/dj-music/DJ_SCRIPTS_LIB/.youtube_music.db

# --- Servidor remoto (lo lee serve_remote.py) ---
# Escucha solo en loopback: publica `tailscale serve`, que anade TLS.
DJ_BIND_HOST=127.0.0.1
DJ_BIND_PORT=5001
# Desactiva los endpoints que administran la maquina (browse, escribir .env,
# reinicios, pip install). Se configura por SSH.
DJ_PUBLIC_MODE=1
# Exige la cabecera Tailscale-User-Login que inyecta `tailscale serve`.
DJ_REQUIRE_IDENTITY=1
# Correos con acceso, separados por comas. Vacio = cualquiera de la tailnet.
DJ_ALLOWED_USERS=
# Clave de sesion estable (generar con: openssl rand -hex 32)
DJ_SECRET_KEY=

# --- Opcional ---
LASTFM_API_KEY=
# Identifica canciones por huella acústica (fpcalc) y saca el género de
# MusicBrainz. Gratis en https://acoustid.org/api-key. Requiere el paquete
# del sistema libchromaprint-tools (ver paso 1 de este README).
ACOUSTID_API_KEY=
PLAYLIST_TIMEOUT=180
